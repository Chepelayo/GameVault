<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema principal: Material 3 DayNight -->
    <style name="Theme.TheLastOne" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/steam_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/steam_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/steam_container</item>
        <item name="colorOnSecondaryContainer">@color/steam_on_container</item>
        <item name="android:colorBackground">@color/steam_bg</item>
        <item name="colorSurface">@color/steam_surface</item>
        <item name="colorOnSurface">@color/steam_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/steam_text_secondary</item>
        <item name="colorOutline">@color/steam_stroke</item>
        <item name="android:statusBarColor">@color/steam_header</item>
        <item name="android:navigationBarColor">@color/steam_header</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="materialButtonStyle">@style/Widget.TheLastOne.Button</item>
    </style>

    <!-- Botón verde-->
    <style name="Widget.TheLastOne.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/steam_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <!-- Tarjeta con borde fino -->
    <style name="Widget.TheLastOne.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/steam_surface</item>
        <item name="cardCornerRadius">6dp</item>
        <item name="strokeColor">@color/steam_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Títulos de sección -->
    <style name="TextAppearance.TheLastOne.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/steam_accent</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Toolbars oscuras con texto e iconos claros -->
    <style name="ThemeOverlay.TheLastOne.Header" parent="ThemeOverlay.Material3.Dark">
        <item name="colorControlNormal">@color/steam_on_header</item>
        <item name="colorOnSurface">@color/steam_on_header</item>
    </style>
</resources>